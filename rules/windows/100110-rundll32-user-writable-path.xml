<group name="local,windows,attack,">
  <rule id="100110" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\rundll32\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\\(?:users|programdata|temp|appdata)\\</field>
    <description>Rundll32 started with a DLL path in a user-writable directory</description>
    <mitre>
      <id>T1218.011</id>
    </mitre>
    <group>attack.defense_evasion,rundll32,</group>
  </rule>
</group>

