<group name="local,windows,attack,">
  <rule id="110140" level="12">
    <field name="win.system.providerName">^Microsoft-Windows-Sysmon$</field>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\net(?:1)?\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:^|\s)user\s+\S+.*(?:\s|/)/add(?:\s|$)</field>
    <description>Local account created using net user</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
    <group>attack.persistence,account_creation,</group>
  </rule>
</group>
